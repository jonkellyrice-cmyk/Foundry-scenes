{
  "schemaVersion": 1,
  "id": "release-0-3-4",
  "phase": "release-0-3-4",
  "summary": "Bump the Ghost Ship template and module to 0.3.4 and point the module cover at the browser-safe release-generated JPEG.",
  "operations": [
    {
      "op": "replace",
      "path": "scripts/orphaned-sun-scenes.mjs",
      "before": "const GHOST_SHIP_TEMPLATE_VERSION = \"0.3.3\";",
      "after": "const GHOST_SHIP_TEMPLATE_VERSION = \"0.3.4\";",
      "expectedOccurrences": 1
    },
    {
      "op": "json-set",
      "path": "module.json",
      "keyPath": ["version"],
      "expected": "0.3.3",
      "value": "0.3.4"
    },
    {
      "op": "replace",
      "path": "module.json",
      "before": "modules/orphaned-sun-scenes/assets/maps/signatory-ghost-ship.webp",
      "after": "modules/orphaned-sun-scenes/assets/maps/signatory-ghost-ship.jpg",
      "expectedOccurrences": 1
    }
  ],
  "checks": [
    {
      "name": "Template and manifest versions agree",
      "run": "grep -q 'GHOST_SHIP_TEMPLATE_VERSION = \"0.3.4\"' scripts/orphaned-sun-scenes.mjs && node -e \"const m=JSON.parse(require('fs').readFileSync('module.json','utf8')); if(m.version!=='0.3.4') process.exit(1);\""
    },
    {
      "name": "Manifest uses JPEG cover",
      "run": "grep -q 'signatory-ghost-ship.jpg' module.json"
    },
    {
      "name": "Release workflow produces and validates JPEG",
      "run": "grep -q 'signatory-ghost-ship.jpg' .github/workflows/release.yml && grep -q 'ffmpeg' .github/workflows/release.yml"
    }
  ]
}
