{
  "schemaVersion": 1,
  "id": "release-0-3-3",
  "phase": "release-0-3-3",
  "summary": "Bump the Ghost Ship template and Foundry module manifest to 0.3.3 so the repaired asset delivery is distributed through Forge.",
  "operations": [
    {
      "op": "replace",
      "path": "scripts/orphaned-sun-scenes.mjs",
      "before": "const GHOST_SHIP_TEMPLATE_VERSION = \"0.3.2\";",
      "after": "const GHOST_SHIP_TEMPLATE_VERSION = \"0.3.3\";",
      "expectedOccurrences": 1
    },
    {
      "op": "json-set",
      "path": "module.json",
      "pointer": "/version",
      "value": "0.3.3"
    }
  ],
  "checks": [
    {
      "name": "Ghost Ship script syntax",
      "run": "node --check scripts/orphaned-sun-scenes.mjs"
    },
    {
      "name": "Template and manifest versions agree",
      "run": "grep -q 'GHOST_SHIP_TEMPLATE_VERSION = \"0.3.3\"' scripts/orphaned-sun-scenes.mjs && node -e \"const m=JSON.parse(require('fs').readFileSync('module.json','utf8')); if(m.version!=='0.3.3') process.exit(1);\""
    }
  ]
}
