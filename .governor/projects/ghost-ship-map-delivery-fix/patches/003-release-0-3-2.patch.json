{
  "schemaVersion": 1,
  "id": "release-0-3-2",
  "phase": "release-0-3-2",
  "summary": "Bump the managed Ghost Ship template and module manifest to 0.3.2 so Forge receives the map-delivery repair.",
  "operations": [
    {
      "op": "replace",
      "path": "scripts/orphaned-sun-scenes.mjs",
      "before": "const GHOST_SHIP_TEMPLATE_VERSION = \"0.3.1\";",
      "after": "const GHOST_SHIP_TEMPLATE_VERSION = \"0.3.2\";",
      "expectedOccurrences": 1
    },
    {
      "op": "json-set",
      "path": "module.json",
      "keyPath": ["version"],
      "expected": "0.3.1",
      "value": "0.3.2"
    }
  ],
  "checks": [
    {
      "name": "Managed template version is 0.3.2",
      "run": "grep -q 'GHOST_SHIP_TEMPLATE_VERSION = \"0.3.2\"' scripts/orphaned-sun-scenes.mjs"
    },
    {
      "name": "Manifest version is 0.3.2",
      "run": "node -e \"const m=JSON.parse(require('fs').readFileSync('module.json','utf8')); if(m.version!=='0.3.2') throw new Error('expected 0.3.2');\""
    }
  ]
}
