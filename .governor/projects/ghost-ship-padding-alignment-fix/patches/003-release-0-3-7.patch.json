{
  "schemaVersion": 1,
  "id": "release-0-3-7",
  "phase": "release-0-3-7",
  "summary": "Advance the Ghost Ship template and module version to 0.3.7 so existing 0.3.6 worlds run the zero-padding geometry migration and Forge receives the aligned scene release.",
  "operations": [
    {
      "op": "replace",
      "path": "scripts/orphaned-sun-scenes.mjs",
      "before": "const GHOST_SHIP_TEMPLATE_VERSION = \"0.3.6\";",
      "after": "const GHOST_SHIP_TEMPLATE_VERSION = \"0.3.7\";",
      "expectedOccurrences": 1
    },
    {
      "op": "json-set",
      "path": "module.json",
      "keyPath": ["version"],
      "expected": "0.3.6",
      "value": "0.3.7"
    }
  ],
  "checks": [
    {
      "name": "Ghost Ship template version",
      "run": "grep -q 'GHOST_SHIP_TEMPLATE_VERSION = \"0.3.7\"' scripts/orphaned-sun-scenes.mjs"
    },
    {
      "name": "Manifest version",
      "run": "node -e \"const m=JSON.parse(require('fs').readFileSync('module.json','utf8')); if(m.version!=='0.3.7') throw new Error('expected 0.3.7');\""
    },
    {
      "name": "Release workflow remains available",
      "run": "test -s .github/workflows/release.yml"
    }
  ]
}
