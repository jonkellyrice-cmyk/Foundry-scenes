<section class="os-library-shell">
  <nav class="os-tool-tabs" aria-label="Orphaned Sun GM Tools">
    <button type="button" class="{{#if tabScenes}}is-active{{/if}}" data-action="showScenes">
      <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
      Scene Library
    </button>
    <button type="button" class="{{#if tabDiagnostics}}is-active{{/if}}" data-action="showDiagnostics">
      <i class="fa-solid fa-stethoscope" aria-hidden="true"></i>
      Scene Library Diagnostics
    </button>
    <button type="button" class="{{#if tabComic}}is-active{{/if}}" data-action="showComic">
      <i class="fa-solid fa-book-open" aria-hidden="true"></i>
      Comic Book Scene
    </button>
  </nav>

  {{#if tabScenes}}
    <header class="os-library-summary">
      <div>
        <p class="os-library-kicker">MODULE v{{moduleVersion}}</p>
        <h2>Scene Library</h2>
        <p>Import a bundled scene into this world, then use Foundry's normal scene tools to modify the world copy however you like.</p>
      </div>
      <div class="os-library-summary-stats" aria-label="Scene library summary">
        <strong>{{installedCount}} / {{sceneCount}}</strong>
        <span>in world</span>
      </div>
    </header>

    <div class="os-library-toolbar">
      <button type="button" data-action="refresh">
        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
        Refresh
      </button>
      <button type="button" data-action="toggleAutoCreate">
        <i class="fa-solid {{#if autoCreate}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i>
        First scene auto-create: {{#if autoCreate}}On{{else}}Off{{/if}}
      </button>
    </div>

    <div class="os-scene-list">
      {{#each scenes}}
        <article class="os-scene-card" data-scene-key="{{key}}">
          <div class="os-scene-preview">
            <img src="{{preview}}" alt="Preview of {{title}}">
            <span class="os-scene-status {{#if installed}}is-installed{{else}}is-library{{/if}}">
              {{#if installed}}In World{{else}}Bundled{{/if}}
            </span>
          </div>

          <div class="os-scene-body">
            <div class="os-scene-title-row">
              <div>
                <h3>{{title}}</h3>
                <p class="os-scene-subtitle">{{subtitle}}</p>
              </div>
              {{#if installed}}
                <i class="fa-solid fa-circle-check os-installed-icon" title="Imported into this world" aria-label="Imported into this world"></i>
              {{/if}}
            </div>

            <p class="os-scene-description">{{description}}</p>

            <div class="os-scene-tags" aria-label="Scene tags">
              {{#each tags}}<span>{{this}}</span>{{/each}}
            </div>

            <dl class="os-scene-metrics">
              <div><dt>Walls</dt><dd>{{wallCount}}</dd></div>
              <div><dt>Doors</dt><dd>{{doorCount}}</dd></div>
              <div><dt>Lights</dt><dd>{{lightCount}}</dd></div>
              <div><dt>Source</dt><dd>{{sourceVersion}}</dd></div>
            </dl>

            {{#if installed}}
              <div class="os-primary-actions">
                <button type="button" data-action="openScene">
                  <i class="fa-solid fa-eye" aria-hidden="true"></i> Open
                </button>
                <button type="button" data-action="editWalls">
                  <i class="fa-solid fa-vector-square" aria-hidden="true"></i> Walls
                </button>
                <button type="button" data-action="editLighting">
                  <i class="fa-solid fa-lightbulb" aria-hidden="true"></i> Lighting
                </button>
                <button type="button" data-action="configureScene">
                  <i class="fa-solid fa-sliders" aria-hidden="true"></i> Configure
                </button>
              </div>

              <details class="os-scene-advanced">
                <summary>Scene management</summary>
                <div class="os-secondary-actions">
                  <button type="button" data-action="duplicateScene">
                    <i class="fa-solid fa-copy" aria-hidden="true"></i> Create Working Copy
                  </button>
                  <button type="button" data-action="restoreScene">
                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> Restore Bundled Version
                  </button>
                  <button type="button" class="danger" data-action="removeScene">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i> Remove From World
                  </button>
                </div>
                <p class="hint">A Working Copy is independent of the module-managed scene. Restoring the bundled version does not touch working copies.</p>
              </details>
            {{else}}
              <div class="os-primary-actions">
                <button type="button" data-action="importScene">
                  <i class="fa-solid fa-file-import" aria-hidden="true"></i> Import To World
                </button>
              </div>
            {{/if}}
          </div>
        </article>
      {{/each}}
    </div>

    <footer class="os-library-footer">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      <span>Imported scenes are normal Foundry scenes. Edit walls, lights, doors, sounds, tokens, and scene settings normally; the module will not silently overwrite those edits.</span>
    </footer>
  {{/if}}

  {{#if tabDiagnostics}}
    <header class="os-library-summary os-diagnostics-summary">
      <div>
        <p class="os-library-kicker">MODULE v{{moduleVersion}} · READ-ONLY TELEMETRY</p>
        <h2>Scene Library Diagnostics</h2>
        <p>Live Foundry telemetry for the managed Ghost Ship scene. This panel does not modify the scene; it exists so troubleshooting can happen without hunting through the browser console.</p>
      </div>
      <div class="os-library-summary-stats" aria-label="Diagnostic suspect summary">
        <strong>{{diagnostics.greenArtifactCandidates}}</strong>
        <span>visual suspects</span>
      </div>
    </header>

    <div class="os-library-toolbar">
      <button type="button" data-action="diagnosticsRefresh">
        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Refresh telemetry
      </button>
      <button type="button" data-action="diagnosticsPickPoint">
        <i class="fa-solid fa-crosshairs" aria-hidden="true"></i> Pick artifact point
      </button>
      <button type="button" data-action="diagnosticsCopy">
        <i class="fa-solid fa-clipboard" aria-hidden="true"></i> Copy diagnostic JSON
      </button>
    </div>

    {{#if diagnostics.available}}
      <div class="os-diagnostics-grid">
        <section class="os-diagnostic-card">
          <h3><i class="fa-solid fa-image"></i> Map asset</h3>
          <dl class="os-diagnostic-kv">
            <div><dt>Status</dt><dd class="{{#if diagnostics.background.ok}}is-good{{else}}is-bad{{/if}}">{{diagnostics.background.status}}</dd></div>
            <div><dt>Decoded size</dt><dd>{{diagnostics.background.width}} × {{diagnostics.background.height}}</dd></div>
            <div><dt>Bytes</dt><dd>{{diagnostics.background.bytes}}</dd></div>
            <div><dt>MIME</dt><dd>{{diagnostics.background.type}}</dd></div>
          </dl>
          <p class="os-diagnostic-path" title="{{diagnostics.background.src}}">{{diagnostics.background.src}}</p>
        </section>

        <section class="os-diagnostic-card">
          <h3><i class="fa-solid fa-ruler-combined"></i> Scene geometry</h3>
          <dl class="os-diagnostic-kv">
            <div><dt>Canonical</dt><dd class="{{#if diagnostics.geometry.canonical}}is-good{{else}}is-bad{{/if}}">{{#if diagnostics.geometry.canonical}}Yes{{else}}No{{/if}}</dd></div>
            <div><dt>Scene</dt><dd>{{diagnostics.geometry.width}} × {{diagnostics.geometry.height}}</dd></div>
            <div><dt>Padding</dt><dd>{{diagnostics.geometry.padding}}</dd></div>
            <div><dt>sceneX / sceneY</dt><dd>{{diagnostics.geometry.sceneX}} / {{diagnostics.geometry.sceneY}}</dd></div>
            <div><dt>Canvas</dt><dd>{{diagnostics.geometry.canvasWidth}} × {{diagnostics.geometry.canvasHeight}}</dd></div>
            <div><dt>BG scale</dt><dd>{{diagnostics.geometry.backgroundScaleX}} / {{diagnostics.geometry.backgroundScaleY}}</dd></div>
            <div><dt>BG offset</dt><dd>{{diagnostics.geometry.backgroundOffsetX}} / {{diagnostics.geometry.backgroundOffsetY}}</dd></div>
            <div><dt>BG rotation</dt><dd>{{diagnostics.geometry.backgroundRotation}}</dd></div>
          </dl>
        </section>

        <section class="os-diagnostic-card">
          <h3><i class="fa-solid fa-display"></i> Canvas runtime</h3>
          <dl class="os-diagnostic-kv">
            <div><dt>Canvas ready</dt><dd>{{#if diagnostics.canvas.ready}}Yes{{else}}No{{/if}}</dd></div>
            <div><dt>Viewing this scene</dt><dd>{{#if diagnostics.canvas.viewedScene}}Yes{{else}}No{{/if}}</dd></div>
            <div><dt>Active layer</dt><dd>{{diagnostics.canvas.activeLayer}}</dd></div>
            <div><dt>Stage scale</dt><dd>{{diagnostics.canvas.stageScaleX}} / {{diagnostics.canvas.stageScaleY}}</dd></div>
            <div><dt>Stage pivot</dt><dd>{{diagnostics.canvas.stagePivotX}} / {{diagnostics.canvas.stagePivotY}}</dd></div>
            <div><dt>Browser viewport</dt><dd>{{diagnostics.canvas.screenWidth}} × {{diagnostics.canvas.screenHeight}}</dd></div>
          </dl>
        </section>

        <section class="os-diagnostic-card">
          <h3><i class="fa-solid fa-layer-group"></i> Embedded documents</h3>
          <div class="os-diagnostic-counts">
            <span><strong>{{diagnostics.counts.walls}}</strong> Walls</span>
            <span><strong>{{diagnostics.counts.doors}}</strong> Doors</span>
            <span><strong>{{diagnostics.counts.lights}}</strong> Lights</span>
            <span><strong>{{diagnostics.counts.tiles}}</strong> Tiles</span>
            <span><strong>{{diagnostics.counts.tokens}}</strong> Tokens</span>
            <span><strong>{{diagnostics.counts.drawings}}</strong> Drawings</span>
            <span><strong>{{diagnostics.counts.regions}}</strong> Regions</span>
            <span><strong>{{diagnostics.counts.templates}}</strong> Templates</span>
            <span><strong>{{diagnostics.counts.sounds}}</strong> Sounds</span>
            <span><strong>{{diagnostics.counts.notes}}</strong> Notes</span>
          </div>
        </section>
      </div>

      <section class="os-diagnostic-card os-artifact-probe">
        <div class="os-diagnostic-heading">
          <div>
            <p class="os-library-kicker">TARGETED VISUAL TELEMETRY</p>
            <h3><i class="fa-solid fa-eye"></i> Green artifact probe</h3>
          </div>
          <span class="os-diagnostic-badge">{{diagnostics.greenArtifactCandidates}} candidates</span>
        </div>
        <p>{{diagnostics.artifactAssessment}}</p>

        <div class="os-diagnostic-suspect-columns">
          <div>
            <h4>Scene document suspects</h4>
            {{#each diagnostics.greenSceneCandidates}}
              <article class="os-diagnostic-suspect">
                <strong>{{type}} · {{id}}</strong>
                <span>{{reason}}</span>
                <code>{{detail}}</code>
              </article>
            {{else}}
              <p class="os-diagnostic-empty">No green/oversized Tile or Drawing suspects detected in the Scene document.</p>
            {{/each}}
          </div>
          <div>
            <h4>Browser UI / DOM green surfaces</h4>
            {{#each diagnostics.greenDomCandidates}}
              <article class="os-diagnostic-suspect">
                <strong>&lt;{{tag}}&gt; {{#if id}}#{{id}}{{/if}} {{classes}}</strong>
                <span>{{background}} · {{position}} · z {{zIndex}}</span>
                <code>x{{x}} y{{y}} · {{width}}×{{height}}</code>
              </article>
            {{else}}
              <p class="os-diagnostic-empty">No large visible DOM element with a strong-green computed background was detected.</p>
            {{/each}}
          </div>
        </div>
      </section>

      {{#if diagnostics.pointProbe}}
        <section class="os-diagnostic-card os-point-probe">
          <div class="os-diagnostic-heading">
            <div>
              <p class="os-library-kicker">DIRECT SCREEN-POINT TELEMETRY</p>
              <h3><i class="fa-solid fa-crosshairs"></i> Picked artifact point</h3>
            </div>
            <span class="os-diagnostic-badge">x{{diagnostics.pointProbe.x}} · y{{diagnostics.pointProbe.y}}</span>
          </div>
          <p>{{diagnostics.pointProbe.status}}. The stack is ordered from the topmost browser element downward. Matching visual CSS rules are included where the browser exposes their stylesheet.</p>

          <div class="os-point-stack">
            {{#each diagnostics.pointProbe.stack}}
              <article class="os-point-stack-entry {{#if green}}is-green{{/if}}">
                <div class="os-point-stack-title">
                  <strong>#{{rank}} &lt;{{tag}}&gt; {{#if id}}#{{id}}{{/if}} {{classes}}</strong>
                  {{#if green}}<span class="os-diagnostic-badge">green signal</span>{{/if}}
                </div>
                <code>x{{x}} y{{y}} · {{width}}×{{height}} · {{position}} · z {{zIndex}}</code>
                <dl class="os-diagnostic-kv os-point-style-kv">
                  <div><dt>Background</dt><dd>{{background}}</dd></div>
                  <div><dt>BG image</dt><dd>{{backgroundImage}}</dd></div>
                  <div><dt>Box shadow</dt><dd>{{boxShadow}}</dd></div>
                  <div><dt>Opacity / filter</dt><dd>{{opacity}} / {{filter}}</dd></div>
                  <div><dt>Blend / isolation</dt><dd>{{mixBlendMode}} / {{isolation}}</dd></div>
                  <div><dt>--system-color</dt><dd>{{systemColor}}</dd></div>
                  <div><dt>::before</dt><dd>{{before.background}} · {{before.backgroundImage}}</dd></div>
                  <div><dt>::after</dt><dd>{{after.background}} · {{after.backgroundImage}}</dd></div>
                </dl>
                {{#if visualRules.length}}
                  <details class="os-point-css-rules">
                    <summary>Matching visual CSS rules ({{visualRules.length}})</summary>
                    {{#each visualRules}}
                      <div class="os-point-css-rule">
                        <strong>{{selector}}</strong>
                        <span>{{source}}</span>
                        <code>{{css}}</code>
                      </div>
                    {{/each}}
                  </details>
                {{/if}}
              </article>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if diagnostics.hasWarnings}}
        <section class="os-diagnostic-card os-diagnostic-warnings">
          <h3><i class="fa-solid fa-triangle-exclamation"></i> Diagnostic observations</h3>
          <ul>
            {{#each diagnostics.warnings}}<li>{{this}}</li>{{/each}}
          </ul>
        </section>
      {{/if}}

      {{#if diagnostics.tiles.length}}
        <details class="os-diagnostic-details">
          <summary>Tile inventory ({{diagnostics.tiles.length}})</summary>
          <div class="os-diagnostic-table-wrap">
            <table class="os-diagnostic-table">
              <thead><tr><th>ID</th><th>Source</th><th>Position</th><th>Size</th><th>Elev/Sort</th><th>Flags</th></tr></thead>
              <tbody>
                {{#each diagnostics.tiles}}
                  <tr>
                    <td><code>{{id}}</code></td>
                    <td class="os-diagnostic-source">{{src}}</td>
                    <td>{{x}}, {{y}}</td>
                    <td>{{width}}×{{height}}</td>
                    <td>{{elevation}} / {{sort}}</td>
                    <td>{{#if legacyMap}}legacy-map {{/if}}{{#if large}}large {{/if}}{{#if green}}green{{/if}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </details>
      {{/if}}

      {{#if diagnostics.drawings.length}}
        <details class="os-diagnostic-details">
          <summary>Drawing inventory ({{diagnostics.drawings.length}})</summary>
          <div class="os-diagnostic-table-wrap">
            <table class="os-diagnostic-table">
              <thead><tr><th>ID</th><th>Position</th><th>Size</th><th>Fill</th><th>Stroke</th></tr></thead>
              <tbody>
                {{#each diagnostics.drawings}}
                  <tr><td><code>{{id}}</code></td><td>{{x}}, {{y}}</td><td>{{width}}×{{height}}</td><td>{{fill}}</td><td>{{stroke}}</td></tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </details>
      {{/if}}

      <footer class="os-library-footer">
        <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
        <span>Use <strong>Copy diagnostic JSON</strong> to give ChatGPT a complete machine-readable snapshot of this scene and the visible browser UI when a problem is present.</span>
      </footer>
    {{else}}
      <section class="os-diagnostic-card">
        <h3>Ghost Ship not installed</h3>
        <p>{{diagnostics.message}}</p>
        <p>The DOM green-surface probe can still run: {{diagnostics.greenArtifactCandidates}} candidate(s) detected.</p>
      </section>
    {{/if}}
  {{/if}}

  {{#if tabComic}}
    <header class="os-library-summary os-comic-summary">
      <div>
        <p class="os-library-kicker">COMIC BOOK SCENE</p>
        <h2>Sequential Story Page</h2>
        <p>Arrange illustrations into comic panels, export them as hidden Foundry Tiles, then reveal each image as the scene unfolds.</p>
      </div>
      <div class="os-library-summary-stats" aria-label="Comic panel summary">
        <strong>{{comic.panelCount}} / {{comic.capacity}}</strong>
        <span>panels</span>
      </div>
    </header>

    <div class="os-comic-controls">
      <label>
        <span>Scene name</span>
        <input type="text" name="comicTitle" value="{{comic.draft.title}}" autocomplete="off">
      </label>
      <label>
        <span>Page</span>
        <select name="comicOrientation">
          {{#each comic.orientations}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>Panel layout</span>
        <select name="comicLayout">
          {{#each comic.layouts}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>

    <div class="os-comic-workspace">
      <div class="os-comic-preview-wrap">
        <div class="os-comic-page-preview" style="aspect-ratio: {{comic.pageAspect}};">
          {{#each comic.panels}}
            {{#if hasSlot}}
              <figure class="os-comic-preview-panel" style="{{previewStyle}}">
                <img src="{{src}}" alt="Panel {{number}} preview">
                <span>{{number}}</span>
              </figure>
            {{/if}}
          {{/each}}
        </div>
        <p class="hint">Black gutters and an off-white page are created automatically in Foundry. Panel images use cover-cropping and start hidden from players.</p>
      </div>

      <div class="os-comic-panel-editor">
        <div class="os-comic-dropzone" data-comic-dropzone>
          <i class="fa-solid fa-images" aria-hidden="true"></i>
          <strong>Drop images here</strong>
          <span>or</span>
          <button type="button" data-action="comicChooseFiles">Choose image files</button>
          <input type="file" accept="image/*" multiple hidden data-comic-files>
        </div>

        <div class="os-comic-path-row">
          <input type="text" name="comicImagePath" placeholder="Existing Foundry path, module asset, or image URL">
          <button type="button" data-action="comicAddPath">
            <i class="fa-solid fa-link" aria-hidden="true"></i> Add Path
          </button>
        </div>

        {{#if comic.overCapacity}}
          <p class="os-comic-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> This layout does not have enough slots. Choose a larger layout or remove panels before exporting.</p>
        {{/if}}

        <div class="os-comic-panel-list">
          {{#each comic.panels}}
            <article class="os-comic-panel-row" data-panel-id="{{id}}">
              <img src="{{src}}" alt="{{label}}">
              <div class="os-comic-panel-meta">
                <strong>Panel {{number}}</strong>
                <span title="{{src}}">{{label}}</span>
              </div>
              <div class="os-comic-panel-actions">
                <button type="button" data-action="comicMoveUp" title="Move earlier" aria-label="Move panel earlier"><i class="fa-solid fa-arrow-up"></i></button>
                <button type="button" data-action="comicMoveDown" title="Move later" aria-label="Move panel later"><i class="fa-solid fa-arrow-down"></i></button>
                <button type="button" class="danger" data-action="comicRemovePanel" title="Remove panel" aria-label="Remove panel"><i class="fa-solid fa-trash"></i></button>
              </div>
            </article>
          {{else}}
            <p class="os-comic-empty">No panels yet. Upload or drop one or more illustrations to start the page.</p>
          {{/each}}
        </div>
      </div>
    </div>

    <div class="os-comic-export-bar">
      <button type="button" class="danger" data-action="comicClear">
        <i class="fa-solid fa-eraser" aria-hidden="true"></i> Clear Draft
      </button>
      <button type="button" class="os-comic-export" data-action="comicExport" {{#if comic.overCapacity}}disabled{{/if}}>
        <i class="fa-solid fa-clapperboard" aria-hidden="true"></i> Create Comic Book Scene
      </button>
    </div>

    <footer class="os-library-footer">
      <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
      <span>Every story-image Tile is exported with visibility off. The paper and black panel frames stay visible, so you can reveal the artwork one panel at a time with Foundry's normal Tile visibility control.</span>
    </footer>
  {{/if}}
</section>
