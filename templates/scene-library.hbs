<section class="os-library-shell">
  <nav class="os-tool-tabs" aria-label="Orphaned Sun GM Tools">
    <button type="button" class="{{#if tabScenes}}is-active{{/if}}" data-action="showScenes">
      <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
      Scene Library
    </button>
    <button type="button" class="{{#if tabComic}}is-active{{/if}}" data-action="showComic">
      <i class="fa-solid fa-book-open" aria-hidden="true"></i>
      Comic Book Scene
    </button>
  </nav>

  {{#if tabScenes}}
    <header class="os-library-summary">
      <div>
        <p class="os-library-kicker">MODULE v{{moduleVersion}}</p>
        <h2>Scene Library</h2>
        <p>Import a bundled scene into this world, then use Foundry's normal scene tools to modify the world copy however you like.</p>
      </div>
      <div class="os-library-summary-stats" aria-label="Scene library summary">
        <strong>{{installedCount}} / {{sceneCount}}</strong>
        <span>in world</span>
      </div>
    </header>

    <div class="os-library-toolbar">
      <button type="button" data-action="refresh">
        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
        Refresh
      </button>
      <button type="button" data-action="toggleAutoCreate">
        <i class="fa-solid {{#if autoCreate}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i>
        First scene auto-create: {{#if autoCreate}}On{{else}}Off{{/if}}
      </button>
    </div>

    <div class="os-scene-list">
      {{#each scenes}}
        <article class="os-scene-card" data-scene-key="{{key}}">
          <div class="os-scene-preview">
            <img src="{{preview}}" alt="Preview of {{title}}">
            <span class="os-scene-status {{#if installed}}is-installed{{else}}is-library{{/if}}">
              {{#if installed}}In World{{else}}Bundled{{/if}}
            </span>
          </div>

          <div class="os-scene-body">
            <div class="os-scene-title-row">
              <div>
                <h3>{{title}}</h3>
                <p class="os-scene-subtitle">{{subtitle}}</p>
              </div>
              {{#if installed}}
                <i class="fa-solid fa-circle-check os-installed-icon" title="Imported into this world" aria-label="Imported into this world"></i>
              {{/if}}
            </div>

            <p class="os-scene-description">{{description}}</p>

            <div class="os-scene-tags" aria-label="Scene tags">
              {{#each tags}}<span>{{this}}</span>{{/each}}
            </div>

            <dl class="os-scene-metrics">
              <div><dt>Walls</dt><dd>{{wallCount}}</dd></div>
              <div><dt>Doors</dt><dd>{{doorCount}}</dd></div>
              <div><dt>Lights</dt><dd>{{lightCount}}</dd></div>
              <div><dt>Source</dt><dd>{{sourceVersion}}</dd></div>
            </dl>

            {{#if installed}}
              <div class="os-primary-actions">
                <button type="button" data-action="openScene">
                  <i class="fa-solid fa-eye" aria-hidden="true"></i> Open
                </button>
                <button type="button" data-action="editWalls">
                  <i class="fa-solid fa-vector-square" aria-hidden="true"></i> Walls
                </button>
                <button type="button" data-action="editLighting">
                  <i class="fa-solid fa-lightbulb" aria-hidden="true"></i> Lighting
                </button>
                <button type="button" data-action="configureScene">
                  <i class="fa-solid fa-sliders" aria-hidden="true"></i> Configure
                </button>
              </div>

              <details class="os-scene-advanced">
                <summary>Scene management</summary>
                <div class="os-secondary-actions">
                  <button type="button" data-action="duplicateScene">
                    <i class="fa-solid fa-copy" aria-hidden="true"></i> Create Working Copy
                  </button>
                  <button type="button" data-action="restoreScene">
                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> Restore Bundled Version
                  </button>
                  <button type="button" class="danger" data-action="removeScene">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i> Remove From World
                  </button>
                </div>
                <p class="hint">A Working Copy is independent of the module-managed scene. Restoring the bundled version does not touch working copies.</p>
              </details>
            {{else}}
              <div class="os-primary-actions">
                <button type="button" data-action="importScene">
                  <i class="fa-solid fa-file-import" aria-hidden="true"></i> Import To World
                </button>
              </div>
            {{/if}}
          </div>
        </article>
      {{/each}}
    </div>

    <footer class="os-library-footer">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      <span>Imported scenes are normal Foundry scenes. Edit walls, lights, doors, sounds, tokens, and scene settings normally; the module will not silently overwrite those edits.</span>
    </footer>
  {{/if}}

  {{#if tabComic}}
    <header class="os-library-summary os-comic-summary">
      <div>
        <p class="os-library-kicker">COMIC BOOK SCENE</p>
        <h2>Sequential Story Page</h2>
        <p>Arrange illustrations into comic panels, export them as hidden Foundry Tiles, then reveal each image as the scene unfolds.</p>
      </div>
      <div class="os-library-summary-stats" aria-label="Comic panel summary">
        <strong>{{comic.panelCount}} / {{comic.capacity}}</strong>
        <span>panels</span>
      </div>
    </header>

    <div class="os-comic-controls">
      <label>
        <span>Scene name</span>
        <input type="text" name="comicTitle" value="{{comic.draft.title}}" autocomplete="off">
      </label>
      <label>
        <span>Page</span>
        <select name="comicOrientation">
          {{#each comic.orientations}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>Panel layout</span>
        <select name="comicLayout">
          {{#each comic.layouts}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>

    <div class="os-comic-workspace">
      <div class="os-comic-preview-wrap">
        <div class="os-comic-page-preview" style="aspect-ratio: {{comic.pageAspect}};">
          {{#each comic.panels}}
            {{#if hasSlot}}
              <figure class="os-comic-preview-panel" style="{{previewStyle}}">
                <img src="{{src}}" alt="Panel {{number}} preview">
                <span>{{number}}</span>
              </figure>
            {{/if}}
          {{/each}}
        </div>
        <p class="hint">Black gutters and an off-white page are created automatically in Foundry. Panel images use cover-cropping and start hidden from players.</p>
      </div>

      <div class="os-comic-panel-editor">
        <div class="os-comic-dropzone" data-comic-dropzone>
          <i class="fa-solid fa-images" aria-hidden="true"></i>
          <strong>Drop images here</strong>
          <span>or</span>
          <button type="button" data-action="comicChooseFiles">Choose image files</button>
          <input type="file" accept="image/*" multiple hidden data-comic-files>
        </div>

        <div class="os-comic-path-row">
          <input type="text" name="comicImagePath" placeholder="Existing Foundry path, module asset, or image URL">
          <button type="button" data-action="comicAddPath">
            <i class="fa-solid fa-link" aria-hidden="true"></i> Add Path
          </button>
        </div>

        {{#if comic.overCapacity}}
          <p class="os-comic-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> This layout does not have enough slots. Choose a larger layout or remove panels before exporting.</p>
        {{/if}}

        <div class="os-comic-panel-list">
          {{#each comic.panels}}
            <article class="os-comic-panel-row" data-panel-id="{{id}}">
              <img src="{{src}}" alt="{{label}}">
              <div class="os-comic-panel-meta">
                <strong>Panel {{number}}</strong>
                <span title="{{src}}">{{label}}</span>
              </div>
              <div class="os-comic-panel-actions">
                <button type="button" data-action="comicMoveUp" title="Move earlier" aria-label="Move panel earlier"><i class="fa-solid fa-arrow-up"></i></button>
                <button type="button" data-action="comicMoveDown" title="Move later" aria-label="Move panel later"><i class="fa-solid fa-arrow-down"></i></button>
                <button type="button" class="danger" data-action="comicRemovePanel" title="Remove panel" aria-label="Remove panel"><i class="fa-solid fa-trash"></i></button>
              </div>
            </article>
          {{else}}
            <p class="os-comic-empty">No panels yet. Upload or drop one or more illustrations to start the page.</p>
          {{/each}}
        </div>
      </div>
    </div>

    <div class="os-comic-export-bar">
      <button type="button" class="danger" data-action="comicClear">
        <i class="fa-solid fa-eraser" aria-hidden="true"></i> Clear Draft
      </button>
      <button type="button" class="os-comic-export" data-action="comicExport" {{#if comic.overCapacity}}disabled{{/if}}>
        <i class="fa-solid fa-clapperboard" aria-hidden="true"></i> Create Comic Book Scene
      </button>
    </div>

    <footer class="os-library-footer">
      <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
      <span>Every story-image Tile is exported with visibility off. The paper and black panel frames stay visible, so you can reveal the artwork one panel at a time with Foundry's normal Tile visibility control.</span>
    </footer>
  {{/if}}
</section>
