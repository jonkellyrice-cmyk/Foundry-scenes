<section class="os-library-shell">
  <nav class="os-tool-tabs" aria-label="Orphaned Sun GM Tools">
    <button type="button" class="{{#if tabScenes}}is-active{{/if}}" data-action="showScenes"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> Scene Library</button>
    <button type="button" class="{{#if tabComic}}is-active{{/if}}" data-action="showComic"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Comic Book Scene</button>
  </nav>

  {{#if tabScenes}}
    <header class="os-library-summary">
      <div><p class="os-library-kicker">MODULE v{{moduleVersion}} · LIVE FEED</p><h2>Scene Library</h2><p>Published battle maps are discovered at runtime. Updating the scene library does not require a new module release.</p></div>
      <div class="os-library-summary-stats"><strong>{{installedCount}} / {{sceneCount}}</strong><span>in world</span></div>
    </header>
    <div class="os-library-toolbar">
      <button type="button" data-action="refresh"><i class="fa-solid fa-arrows-rotate"></i> Refresh live feed</button>
      {{#if feedHealthy}}<span class="os-feed-status is-good"><i class="fa-solid fa-cloud-arrow-down"></i> Feed online · latest {{feedUpdatedAt}}</span>{{else}}{{#if feedError}}<span class="os-feed-status is-bad"><i class="fa-solid fa-triangle-exclamation"></i> {{feedError}}</span>{{/if}}{{/if}}
    </div>
    <div class="os-scene-list">
      {{#each scenes}}
        <article class="os-scene-card" data-scene-key="{{key}}">
          <div class="os-scene-preview">
            {{#if preview}}<img src="{{preview}}" alt="Preview of {{title}}">{{else}}<div class="os-scene-preview-placeholder"><i class="fa-solid fa-map"></i><span>Live battle map</span></div>{{/if}}
            <span class="os-scene-status {{#if installed}}is-installed{{else}}is-library{{/if}}">{{#if installed}}In World{{else}}Published{{/if}}</span>
          </div>
          <div class="os-scene-body">
            <div class="os-scene-title-row"><div><h3>{{title}}</h3><p class="os-scene-subtitle">{{subtitle}}</p></div>{{#if installed}}<i class="fa-solid fa-circle-check os-installed-icon"></i>{{/if}}</div>
            <p class="os-scene-description">{{description}}</p>
            <div class="os-scene-tags">{{#each tags}}<span>{{this}}</span>{{/each}}</div>
            <dl class="os-scene-metrics"><div><dt>Walls</dt><dd>{{#if wallCount}}{{wallCount}}{{else}}—{{/if}}</dd></div><div><dt>Doors</dt><dd>{{#if doorCount}}{{doorCount}}{{else}}—{{/if}}</dd></div><div><dt>Lights</dt><dd>{{#if lightCount}}{{lightCount}}{{else}}—{{/if}}</dd></div><div><dt>Source</dt><dd>{{sourceVersion}}</dd></div></dl>
            {{#if installed}}
              {{#if updateAvailable}}<p class="os-feed-update"><i class="fa-solid fa-arrow-up-right-dots"></i> A newer published revision is available.</p>{{/if}}
              <div class="os-primary-actions"><button data-action="openScene"><i class="fa-solid fa-eye"></i> Open</button><button data-action="editWalls"><i class="fa-solid fa-vector-square"></i> Walls</button><button data-action="editLighting"><i class="fa-solid fa-lightbulb"></i> Lighting</button><button data-action="configureScene"><i class="fa-solid fa-sliders"></i> Configure</button></div>
              <details class="os-scene-advanced"><summary>Scene management</summary><div class="os-secondary-actions"><button data-action="duplicateScene"><i class="fa-solid fa-copy"></i> Create Working Copy</button><button data-action="restoreScene"><i class="fa-solid fa-cloud-arrow-down"></i> {{#if updateAvailable}}Update to Published Revision{{else}}Restore Published Revision{{/if}}</button><button class="danger" data-action="removeScene"><i class="fa-solid fa-trash"></i> Remove From World</button></div><p class="hint">Working Copies are independent. Updating or restoring the managed scene never touches them.</p></details>
            {{else}}
              <div class="os-primary-actions"><button data-action="importScene"><i class="fa-solid fa-file-import"></i> Import To World</button></div>
            {{/if}}
          </div>
        </article>
      {{else}}
        <section class="os-live-feed-empty"><i class="fa-solid fa-satellite-dish"></i><h3>No published battle maps yet</h3><p>Publish a battle map from the Lancer GM Kit, then press <strong>Refresh live feed</strong>. No Foundry module update should be required.</p></section>
      {{/each}}
    </div>
    <footer class="os-library-footer"><i class="fa-solid fa-circle-info"></i><span>Imported scenes become normal Foundry Scenes. The live feed does not silently overwrite edits in your world.</span></footer>
  {{/if}}

  {{#if tabComic}}
    <header class="os-library-summary os-comic-summary"><div><p class="os-library-kicker">COMIC BOOK SCENE</p><h2>Sequential Story Page</h2><p>Arrange illustrations into comic panels, export them as hidden Foundry Tiles, then reveal each image as the scene unfolds.</p></div><div class="os-library-summary-stats"><strong>{{comic.panelCount}} / {{comic.capacity}}</strong><span>panels</span></div></header>
    <div class="os-comic-controls"><label><span>Scene name</span><input type="text" name="comicTitle" value="{{comic.draft.title}}"></label><label><span>Page</span><select name="comicOrientation">{{#each comic.orientations}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Panel layout</span><select name="comicLayout">{{#each comic.layouts}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
    <div class="os-comic-workspace"><div class="os-comic-preview-wrap"><div class="os-comic-page-preview" style="aspect-ratio: {{comic.pageAspect}};">{{#each comic.panels}}{{#if hasSlot}}<figure class="os-comic-preview-panel" style="{{previewStyle}}"><img src="{{src}}" alt="Panel {{number}} preview"><span>{{number}}</span></figure>{{/if}}{{/each}}</div><p class="hint">Black gutters and an off-white page are created automatically in Foundry. Panel images use cover-cropping and start hidden from players.</p></div>
      <div class="os-comic-panel-editor"><div class="os-comic-dropzone" data-comic-dropzone><i class="fa-solid fa-images"></i><strong>Drop images here</strong><span>or</span><button data-action="comicChooseFiles">Choose image files</button><input type="file" accept="image/*" multiple hidden data-comic-files></div><div class="os-comic-path-row"><input type="text" name="comicImagePath" placeholder="Existing Foundry path, module asset, or image URL"><button data-action="comicAddPath"><i class="fa-solid fa-link"></i> Add Path</button></div>{{#if comic.overCapacity}}<p class="os-comic-warning">This layout does not have enough slots.</p>{{/if}}<div class="os-comic-panel-list">{{#each comic.panels}}<article class="os-comic-panel-row" data-panel-id="{{id}}"><img src="{{src}}" alt="{{label}}"><div class="os-comic-panel-meta"><strong>Panel {{number}}</strong><span>{{label}}</span></div><div class="os-comic-panel-actions"><button data-action="comicMoveUp"><i class="fa-solid fa-arrow-up"></i></button><button data-action="comicMoveDown"><i class="fa-solid fa-arrow-down"></i></button><button class="danger" data-action="comicRemovePanel"><i class="fa-solid fa-trash"></i></button></div></article>{{else}}<p class="os-comic-empty">No panels yet.</p>{{/each}}</div></div></div>
    <div class="os-comic-export-bar"><button class="danger" data-action="comicClear"><i class="fa-solid fa-eraser"></i> Clear Draft</button><button class="os-comic-export" data-action="comicExport" {{#if comic.overCapacity}}disabled{{/if}}><i class="fa-solid fa-clapperboard"></i> Create Comic Book Scene</button></div>
  {{/if}}
</section>
